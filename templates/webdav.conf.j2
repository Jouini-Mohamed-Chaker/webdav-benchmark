# Apache mod_dav WebDAV vhost - listens on 8080, same path/behavior as the
# old nginx dav_module setup but with full WebDAV method support
# (PROPFIND/OPTIONS included natively - no extra modules needed).

Listen 8080

<VirtualHost *:8080>
    ServerName webdav-backend

    Alias /dav {{ webdav_serve_path }}

    <Directory "{{ webdav_serve_path }}">
        DAV On
        Options None
        AllowOverride None
        Require all granted

        # Match previous dav_access user:rw group:rw all:rw intent
        <IfModule mod_headers.c>
            Header set X-WebDAV-Backend "apache-mod_dav"
        </IfModule>
    </Directory>

    # Keep uploads landing in the same tmp dir/filesystem as before
    # (mod_dav writes directly to the target path; DAVLockDB just needs
    # a writable location for lock state).
    DAVLockDB /var/lib/dav/lockdb

    LogLevel warn
    ErrorLog /var/log/httpd/webdav_error.log
    CustomLog /var/log/httpd/webdav_access.log combined
</VirtualHost>
