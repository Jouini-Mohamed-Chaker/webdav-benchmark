# Keepalive connection pool to the backend (avoids a fresh TCP handshake per
# request under high parallel stream counts - a major source of the drops)
upstream webdav_backend_pool {
    server {{ hostvars[groups['webdav_backend'][0]]['inventory_hostname'] }}:8080;
    keepalive 256;
}

server {
    listen 8080 default_server;
    server_name _;

    client_max_body_size 0;
    client_body_buffer_size 16M;

    location / {
        proxy_pass http://webdav_backend_pool;

        # Uploads (client -> backend): stream the request body straight
        # through instead of buffering it in nginx first - avoids doubling
        # up 200MB+ PUTs in memory/disk before they even reach httpd.
        proxy_request_buffering off;

        # Downloads (backend -> client): buffer the response so nginx can
        # do large efficient reads from the upstream socket and forward
        # them in bigger chunks, instead of a tight small-chunk read/write
        # loop per byte. This was previously "off" and was the main source
        # of the ~5x download throughput gap vs a direct connection.
        proxy_buffering on;
        proxy_buffer_size 64k;
        proxy_buffers 8 64k;
        proxy_busy_buffers_size 128k;
        proxy_max_temp_file_size 0;

        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    keepalive_timeout 65s;
    keepalive_requests 100000;
    tcp_nopush on;
    tcp_nodelay on;
    reset_timedout_connection on;
}